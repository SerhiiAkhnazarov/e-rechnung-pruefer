--- /dev/null
+++ b/src/expressions/axes/descendantIndex.ts
@@ -0,0 +1,259 @@
+/**
+ * E-Rechnung Prüfer patch: an opt-in per-document index for the descendant axis.
+ *
+ * Validation rules such as `//cac:TaxCategory[...]` traverse the whole document for every
+ * evaluation; with the index enabled, descendant::name steps are answered from a per-document
+ * table (elements by local name in document order with pre-/post-order numbers), so a step costs
+ * O(log n + results) instead of O(n).
+ *
+ * The index is built lazily on first use, kept in a WeakMap keyed by the document (or detached
+ * root) node, and assumes the document is NOT mutated while enabled and that the DOM is accessed
+ * directly (no custom IDomFacade). It is disabled by default; callers enable it explicitly with
+ * fontoxpath.setDescendantIndexEnabled(true) and may drop an index with
+ * fontoxpath.invalidateDescendantIndex(node).
+ */
+import { ConcreteNode, NODE_TYPES } from '../../domFacade/ConcreteNode';
+
+type IndexEntry = { node: ConcreteNode; pre: number };
+type DocumentIndex = {
+	attributesByLocalName: Map<string, IndexEntry[]>;
+	byLocalName: Map<string, IndexEntry[]>;
+	post: Map<ConcreteNode, number>;
+	pre: Map<ConcreteNode, number>;
+};
+
+const XMLNS_NAMESPACE_URI = 'http://www.w3.org/2000/xmlns/';
+
+let enabled = false;
+const indexes = new WeakMap<ConcreteNode, DocumentIndex>();
+// every numbered node (and every indexed attribute) -> the index of its tree
+const nodeToIndex = new WeakMap<ConcreteNode, DocumentIndex>();
+const childIndexes = new WeakMap<ConcreteNode, Map<string, ConcreteNode[]>>();
+
+/**
+ * Element children of `parent` with local name `localName`, in document order (cached per parent).
+ */
+export function findChildrenByLocalName(parent: ConcreteNode, localName: string): ConcreteNode[] {
+	let byName = childIndexes.get(parent);
+	if (!byName) {
+		byName = new Map<string, ConcreteNode[]>();
+		for (let c: any = (parent as any).firstChild; c; c = c.nextSibling) {
+			if (c.nodeType !== NODE_TYPES.ELEMENT_NODE) {
+				continue;
+			}
+			let list = byName.get(c.localName);
+			if (!list) {
+				list = [];
+				byName.set(c.localName, list);
+			}
+			list.push(c);
+		}
+		childIndexes.set(parent, byName);
+	}
+	return byName.get(localName) || [];
+}
+
+export function setDescendantIndexEnabled(value: boolean): void {
+	enabled = value;
+}
+
+export function isDescendantIndexEnabled(): boolean {
+	return enabled;
+}
+
+export function invalidateDescendantIndex(node: ConcreteNode): void {
+	indexes.delete(rootOf(node));
+	childIndexes.delete(node);
+}
+
+function rootOf(node: ConcreteNode): ConcreteNode {
+	let n: any = node;
+	if (n.nodeType === NODE_TYPES.ATTRIBUTE_NODE) {
+		n = n.ownerElement;
+	}
+	while (n && n.parentNode) {
+		n = n.parentNode;
+	}
+	return n as ConcreteNode;
+}
+
+function build(root: ConcreteNode): DocumentIndex {
+	const byLocalName = new Map<string, IndexEntry[]>();
+	const attributesByLocalName = new Map<string, IndexEntry[]>();
+	const pre = new Map<ConcreteNode, number>();
+	const post = new Map<ConcreteNode, number>();
+	const index: DocumentIndex = { attributesByLocalName, byLocalName, pre, post };
+	let counter = 0;
+	// Iterative depth-first traversal over ALL nodes (elements, text, comments, processing
+	// instructions): every node gets a pre-order number, which is its document-order key. The
+	// attributes of an element get fractional keys between the element and its first child, in the
+	// order the DOM reports them (the XDM leaves attribute order implementation-dependent).
+	// Use an explicit (node, state) stack so that post numbers are assigned when a subtree is done.
+	type Frame = { node: ConcreteNode; child: ConcreteNode | null; started: boolean };
+	const frames: Frame[] = [{ node: root, child: null, started: false }];
+	while (frames.length) {
+		const frame = frames[frames.length - 1];
+		const n: any = frame.node;
+		if (!frame.started) {
+			frame.started = true;
+			const number = counter++;
+			pre.set(n, number);
+			nodeToIndex.set(n, index);
+			if (n.nodeType === NODE_TYPES.ELEMENT_NODE) {
+				const name = n.localName as string;
+				let list = byLocalName.get(name);
+				if (!list) {
+					list = [];
+					byLocalName.set(name, list);
+				}
+				list.push({ node: n, pre: number });
+				const attrs: any = n.attributes;
+				if (attrs && attrs.length) {
+					const count = attrs.length;
+					for (let i = 0; i < count; i++) {
+						const attr: any = attrs[i];
+						if (attr.namespaceURI === XMLNS_NAMESPACE_URI) {
+							// namespace declarations are not attributes in the XDM
+							continue;
+						}
+						const key = number + (i + 1) / (count + 1);
+						pre.set(attr, key);
+						nodeToIndex.set(attr, index);
+						let alist = attributesByLocalName.get(attr.localName);
+						if (!alist) {
+							alist = [];
+							attributesByLocalName.set(attr.localName, alist);
+						}
+						alist.push({ node: attr, pre: key });
+					}
+				}
+			}
+			frame.child = n.firstChild;
+		} else if (frame.child) {
+			frame.child = frame.child.nextSibling;
+		}
+		if (frame.child) {
+			frames.push({ node: frame.child, child: null, started: false });
+		} else {
+			post.set(n, counter - 1);
+			frames.pop();
+		}
+	}
+	return index;
+}
+
+/**
+ * Document-order comparison through the index: negative when a precedes b, positive when b
+ * precedes a, 0 for the same node. Returns undefined when the nodes are not both in one indexed
+ * tree (the caller then falls back to the DOM).
+ */
+export function compareIndexedNodes(a: ConcreteNode, b: ConcreteNode): number | undefined {
+	const ia = nodeToIndex.get(a);
+	if (!ia) {
+		return undefined;
+	}
+	const ib = nodeToIndex.get(b);
+	if (ib !== ia) {
+		return undefined;
+	}
+	const ka = ia.pre.get(a);
+	const kb = ia.pre.get(b);
+	if (ka === undefined || kb === undefined) {
+		return undefined;
+	}
+	return ka < kb ? -1 : ka > kb ? 1 : 0;
+}
+
+/**
+ * All attributes with local name `localName` on the context node or its element descendants, in
+ * document order (what `//@localName` selects). Returns null when the context node is unknown to
+ * the index.
+ */
+export function findDescendantAttributesByLocalName(
+	contextNode: ConcreteNode,
+	localName: string,
+): ConcreteNode[] | null {
+	const n: any = contextNode;
+	if (n.nodeType === NODE_TYPES.ATTRIBUTE_NODE) {
+		return [];
+	}
+	const index = getIndex(contextNode);
+	const pre = index.pre.get(contextNode);
+	const post = index.post.get(contextNode);
+	if (pre === undefined || post === undefined) {
+		return null;
+	}
+	const list = index.attributesByLocalName.get(localName);
+	if (!list || !list.length) {
+		return [];
+	}
+	let lo = 0;
+	let hi = list.length;
+	while (lo < hi) {
+		const mid = (lo + hi) >> 1;
+		if (list[mid].pre < pre) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	const out: ConcreteNode[] = [];
+	// attributes of the last descendant have keys < post + 1
+	for (let i = lo; i < list.length && list[i].pre < post + 1; i++) {
+		out.push(list[i].node);
+	}
+	return out;
+}
+
+function getIndex(node: ConcreteNode): DocumentIndex {
+	const root = rootOf(node);
+	let index = indexes.get(root);
+	if (!index) {
+		index = build(root);
+		indexes.set(root, index);
+	}
+	return index;
+}
+
+/**
+ * All element descendants (or descendants-or-self) of `contextNode` whose local name is
+ * `localName`, in document order. Returns null when the context node is unknown to the index
+ * (for instance a node created after the index was built).
+ */
+export function findDescendantsByLocalName(
+	contextNode: ConcreteNode,
+	localName: string,
+	inclusive: boolean,
+): ConcreteNode[] | null {
+	const n: any = contextNode;
+	if (n.nodeType === NODE_TYPES.ATTRIBUTE_NODE) {
+		return [];
+	}
+	const index = getIndex(contextNode);
+	const pre = index.pre.get(contextNode);
+	const post = index.post.get(contextNode);
+	if (pre === undefined || post === undefined) {
+		return null;
+	}
+	const list = index.byLocalName.get(localName);
+	if (!list || !list.length) {
+		return [];
+	}
+	const lower = inclusive ? pre : pre + 1;
+	// binary search for the first entry with entry.pre >= lower
+	let lo = 0;
+	let hi = list.length;
+	while (lo < hi) {
+		const mid = (lo + hi) >> 1;
+		if (list[mid].pre < lower) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	const out: ConcreteNode[] = [];
+	for (let i = lo; i < list.length && list[i].pre <= post; i++) {
+		out.push(list[i].node);
+	}
+	return out;
+}
