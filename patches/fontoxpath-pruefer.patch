+/**
+ * E-Rechnung Prüfer patch: canonical lexical representation of xs:double and xs:float
+ * (XPath Functions and Operators 3.1, casting to xs:string): values with 1e-6 <= |v| < 1e6 are
+ * written in decimal notation with the shortest digits that round-trip, all other values in
+ * scientific notation "d.dddE[-]n" with at least one digit after the point ("1.0E21").
+ * xs:float uses the shortest digits that round-trip through float32 (Saxon: "0.33333334").
+ */
+export function shortestFloat32Digits(value: number): string {
+	// value is already a float32-representable number
+	for (let p = 1; p <= 9; p++) {
+		const s = value.toPrecision(p);
+		if (Math.fround(parseFloat(s)) === value) {
+			return s;
+		}
+	}
+	return value.toPrecision(9);
+}
+
+function splitScientific(s: string): { mantissa: string; exponent: number; negative: boolean } {
+	// s like "-1.2345e+19" or "123.45" or "1e-7"
+	let negative = false;
+	if (s.startsWith('-')) {
+		negative = true;
+		s = s.slice(1);
+	}
+	let exponent = 0;
+	const ei = s.search(/[eE]/);
+	if (ei >= 0) {
+		exponent = parseInt(s.slice(ei + 1), 10);
+		s = s.slice(0, ei);
+	}
+	// normalise mantissa to digits without point
+	let digits: string;
+	let pointPos: number;
+	const dot = s.indexOf('.');
+	if (dot >= 0) {
+		digits = s.slice(0, dot) + s.slice(dot + 1);
+		pointPos = dot;
+	} else {
+		digits = s;
+		pointPos = s.length;
+	}
+	// strip leading zeros
+	while (digits.length > 1 && digits[0] === '0') {
+		digits = digits.slice(1);
+		pointPos -= 1;
+	}
+	// strip trailing zeros
+	digits = digits.replace(/0+$/, '');
+	if (digits === '') {
+		digits = '0';
+	}
+	// value = 0.digits * 10^(pointPos + exponent)
+	return { mantissa: digits, exponent: pointPos + exponent, negative };
+}
+
+export function canonicalFloatingPoint(value: number, isFloat: boolean): string {
+	if (Number.isNaN(value)) {
+		return 'NaN';
+	}
+	if (!Number.isFinite(value)) {
+		return value < 0 ? '-INF' : 'INF';
+	}
+	if (value === 0) {
+		return Object.is(value, -0) ? '-0' : '0';
+	}
+	const shortest = isFloat ? shortestFloat32Digits(value) : String(value);
+	const { mantissa, exponent, negative } = splitScientific(shortest);
+	const abs = Math.abs(value);
+	let out: string;
+	if (abs >= 1e-6 && abs < 1e6) {
+		// decimal notation: mantissa digits with the point at `exponent`
+		if (exponent <= 0) {
+			out = '0.' + '0'.repeat(-exponent) + mantissa;
+		} else if (exponent >= mantissa.length) {
+			out = mantissa + '0'.repeat(exponent - mantissa.length);
+		} else {
+			out = mantissa.slice(0, exponent) + '.' + mantissa.slice(exponent);
+		}
+	} else {
+		const first = mantissa[0];
+		const rest = mantissa.slice(1) || '0';
+		out = first + '.' + rest + 'E' + (exponent - 1);
+	}
+	return (negative ? '-' : '') + out;
+}
