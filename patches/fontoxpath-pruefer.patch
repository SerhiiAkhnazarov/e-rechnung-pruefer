+/**
+ * E-Rechnung Prüfer patch: the step `descendant-or-self::node()/attribute::name` (`//@name`) as a
+ * single axis. With the per-document index enabled it is answered from the attribute table;
+ * otherwise it walks the element descendants and their attributes in document order, which is
+ * exactly what the two-step path yields.
+ */
+import { AttributeNodePointer, ChildNodePointer, ElementNodePointer, isTinyNode } from '../../domClone/Pointer';
+import { NODE_TYPES } from '../../domFacade/ConcreteNode';
+import createPointerValue from '../dataTypes/createPointerValue';
+import ISequence from '../dataTypes/ISequence';
+import sequenceFactory from '../dataTypes/sequenceFactory';
+import Value from '../dataTypes/Value';
+import DynamicContext from '../DynamicContext';
+import ExecutionParameters from '../ExecutionParameters';
+import Expression, { RESULT_ORDERINGS } from '../Expression';
+import Specificity from '../Specificity';
+import { BUILT_IN_NAMESPACE_URIS } from '../staticallyKnownNamespaces';
+import TestAbstractExpression from '../tests/TestAbstractExpression';
+import { Bucket, intersectBuckets } from '../util/Bucket';
+import { DONE_TOKEN, IIterator, IterationHint, ready } from '../util/iterators';
+import { createInclusiveDescendantGenerator } from './DescendantAxis';
+import { findDescendantAttributesByLocalName, isDescendantIndexEnabled } from './descendantIndex';
+import validateContextNode from './validateContextNode';
+
+class DescendantAttributeAxis extends Expression {
+	private readonly _attributeTestExpression: TestAbstractExpression;
+	private readonly _filterBucket: Bucket;
+	private readonly _indexedLocalName: string | null;
+
+	constructor(attributeTestExpression: TestAbstractExpression, filterBucket: Bucket) {
+		super(
+			new Specificity({
+				[Specificity.ATTRIBUTE_KIND]: 1,
+			}),
+			[attributeTestExpression],
+			{
+				canBeStaticallyEvaluated: false,
+				peer: false,
+				resultOrder: RESULT_ORDERINGS.SORTED,
+				subtree: true,
+			},
+		);
+		this._attributeTestExpression = attributeTestExpression;
+		this._filterBucket = intersectBuckets(attributeTestExpression.getBucket(), filterBucket);
+		const testBucket = attributeTestExpression.getBucket();
+		this._indexedLocalName =
+			testBucket && testBucket.startsWith('name-') ? testBucket.slice('name-'.length) : null;
+	}
+
+	public evaluate(dynamicContext: DynamicContext, executionParameters: ExecutionParameters): ISequence {
+		const domFacade = executionParameters.domFacade;
+		const contextPointer = validateContextNode(dynamicContext.contextItem) as ChildNodePointer;
+		const test = (item: Value) =>
+			this._attributeTestExpression.evaluateToBoolean(dynamicContext, item, executionParameters);
+
+		if (
+			isDescendantIndexEnabled() &&
+			this._indexedLocalName !== null &&
+			!contextPointer.graftAncestor &&
+			!isTinyNode(contextPointer.node)
+		) {
+			const nodes = findDescendantAttributesByLocalName(contextPointer.node, this._indexedLocalName);
+			if (nodes !== null) {
+				const values = nodes.map((node) =>
+					createPointerValue({ node, graftAncestor: null } as AttributeNodePointer, domFacade),
+				);
+				return sequenceFactory.create(values).filter(test);
+			}
+		}
+
+		// Fallback: every element descendant-or-self in document order, then its attributes
+		const elements: IIterator<Value> = createInclusiveDescendantGenerator(domFacade, contextPointer, 'type-1');
+		let pending: Value[] = [];
+		let pendingIndex = 0;
+		const iterator: IIterator<Value> = {
+			next: (_hint: IterationHint) => {
+				for (;;) {
+					if (pendingIndex < pending.length) {
+						return ready(pending[pendingIndex++]);
+					}
+					const element = elements.next(IterationHint.NONE);
+					if (element.done) {
+						return DONE_TOKEN;
+					}
+					const pointer = element.value.value as ElementNodePointer;
+					if (domFacade.getNodeType(pointer) !== NODE_TYPES.ELEMENT_NODE) {
+						continue;
+					}
+					pending = domFacade
+						.getAllAttributePointers(pointer, this._filterBucket)
+						.filter(
+							(attr) =>
+								domFacade.getNamespaceURI(attr) !== BUILT_IN_NAMESPACE_URIS.XMLNS_NAMESPACE_URI,
+						)
+						.map((attribute) => createPointerValue(attribute, domFacade))
+						.filter(test);
+					pendingIndex = 0;
+				}
+			},
+		};
+		return sequenceFactory.create(iterator);
+	}
+
+	public override getBucket(): Bucket {
+		return null;
+	}
+}
+export default DescendantAttributeAxis;
