+/**
+ * E-Rechnung Prüfer patch: helpers for exact xs:decimal / xs:integer values.
+ *
+ * An AtomicValue of a decimal type keeps `value` as a JavaScript number (so that every consumer
+ * that only needs an approximation keeps working) and may carry `exact`, the exact Decimal.
+ * Arithmetic, comparisons, rounding, aggregation and string conversion use `exact`; when a value
+ * has no `exact` (for instance a decimal created from a JavaScript number), the exact value is
+ * derived from the number the way Saxon derives it (exact binary expansion for decimals,
+ * exact integer for safe integers).
+ */
+import AtomicValue from './AtomicValue';
+import isSubtypeOf from './isSubtypeOf';
+import { ValueType } from './Value';
+import Decimal from './valueTypes/Decimal';
+
+export type ExactAtomicValue = AtomicValue & { exact?: Decimal };
+
+export function isDecimalType(type: ValueType): boolean {
+	return isSubtypeOf(type, ValueType.XSDECIMAL);
+}
+
+export function isIntegerType(type: ValueType): boolean {
+	return isSubtypeOf(type, ValueType.XSINTEGER);
+}
+
+export function exactOf(value: ExactAtomicValue): Decimal {
+	if (value.exact) {
+		return value.exact;
+	}
+	const n = value.value as number;
+	if (isIntegerType(value.type) && Number.isSafeInteger(n)) {
+		return Decimal.fromBigInt(BigInt(n));
+	}
+	return Decimal.fromDouble(n);
+}
+
+export function createExactValue(exact: Decimal, type: ValueType): ExactAtomicValue {
+	const v: ExactAtomicValue = { type, value: exact.toNumber() };
+	v.exact = exact;
+	return v;
+}
+
+export function exactString(value: ExactAtomicValue): string {
+	return exactOf(value).toString();
+}
+
+export function compareExact(a: ExactAtomicValue, b: ExactAtomicValue): number {
+	return exactOf(a).compare(exactOf(b));
+}
