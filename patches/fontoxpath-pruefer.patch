+/**
+ * E-Rechnung Prüfer patch: exact xs:decimal / xs:integer arithmetic.
+ *
+ * Values are kept as `unscaled * 10^-scale` with a BigInt mantissa, exactly like java.math.BigDecimal,
+ * which is what Saxon uses for xs:decimal. Trailing zeros are stripped (Saxon's BigDecimalValue
+ * does the same), so the scale can be negative for values such as 1E+19.
+ *
+ * Division follows Saxon HE (net.sf.saxon.value.BigDecimalValue.DIVIDE_PRECISION = 18):
+ *   scale = max(18, scale(A) - scale(B) + 18), RoundingMode.HALF_DOWN
+ * verified against Saxon HE 12.8 by test/xpath-conformance (e.g. 158 div 14 = 11.285714285714285714,
+ * 1.5 div 7 = 0.2142857142857142857, 15 div 1E19 = 0.0000000000000000015).
+ */
+export default class Decimal {
+	public static readonly DIVIDE_PRECISION = 18;
+	public static readonly ZERO = new Decimal(0n, 0);
+	public static readonly ONE = new Decimal(1n, 0);
+
+	public readonly unscaled: bigint;
+	public readonly scale: number;
+
+	private constructor(unscaled: bigint, scale: number) {
+		// strip trailing zeros
+		if (unscaled === 0n) {
+			this.unscaled = 0n;
+			this.scale = 0;
+			return;
+		}
+		while (unscaled % 10n === 0n) {
+			unscaled /= 10n;
+			scale -= 1;
+		}
+		this.unscaled = unscaled;
+		this.scale = scale;
+	}
+
+	public static of(unscaled: bigint, scale: number): Decimal {
+		return new Decimal(unscaled, scale);
+	}
+
+	public static fromBigInt(value: bigint): Decimal {
+		return new Decimal(value, 0);
+	}
+
+	/** XML Schema decimal lexical form: optional sign, digits, optional fraction ('.5' and '5.' allowed). */
+	public static fromString(text: string): Decimal | null {
+		const s = text.trim();
+		const m = /^([+-])?(\d*)(?:\.(\d*))?$/.exec(s);
+		if (!m || (m[2] === '' && (m[3] === undefined || m[3] === ''))) {
+			return null;
+		}
+		const intPart = m[2] || '';
+		const fracPart = m[3] || '';
+		let unscaled = BigInt(intPart + fracPart || '0');
+		if (m[1] === '-') {
+			unscaled = -unscaled;
+		}
+		return new Decimal(unscaled, fracPart.length);
+	}
+
+	/** XML Schema integer lexical form. */
+	public static fromIntegerString(text: string): Decimal | null {
+		const s = text.trim();
+		if (!/^[+-]?\d+$/.test(s)) {
+			return null;
+		}
+		return new Decimal(BigInt(s), 0);
+	}
+
+	/**
+	 * Exact value of a double (java.math.BigDecimal(double) semantics, as Saxon uses when
+	 * casting xs:double to xs:decimal): the binary value is expanded exactly.
+	 */
+	public static fromDouble(value: number): Decimal {
+		if (!Number.isFinite(value)) {
+			throw new Error('FOCA0002: cannot convert ' + value + ' to xs:decimal');
+		}
+		if (value === 0) {
+			return Decimal.ZERO;
+		}
+		if (Number.isSafeInteger(value)) {
+			return new Decimal(BigInt(value), 0);
+		}
+		const buffer = new DataView(new ArrayBuffer(8));
+		buffer.setFloat64(0, value);
+		const hi = buffer.getUint32(0);
+		const lo = buffer.getUint32(4);
+		const sign = hi >>> 31 ? -1n : 1n;
+		const exponent = (hi >>> 20) & 0x7ff;
+		let mantissa = (BigInt(hi & 0xfffff) << 32n) | BigInt(lo);
+		let exp: number;
+		if (exponent === 0) {
+			exp = -1074; // subnormal
+		} else {
+			mantissa |= 1n << 52n;
+			exp = exponent - 1075;
+		}
+		// value = sign * mantissa * 2^exp
+		if (exp >= 0) {
+			return new Decimal(sign * (mantissa << BigInt(exp)), 0);
+		}
+		// mantissa * 2^exp = mantissa * 5^-exp / 10^-exp
+		const n = -exp;
+		return new Decimal(sign * mantissa * 5n ** BigInt(n), n);
+	}
+
+	public static fromNumber(value: number): Decimal {
+		return Decimal.fromDouble(value);
+	}
+
+	public isZero(): boolean {
+		return this.unscaled === 0n;
+	}
+
+	public isInteger(): boolean {
+		return this.scale <= 0;
