+		const scale = Math.max(a.scale, b.scale);
+		const ua = a.unscaled * 10n ** BigInt(scale - a.scale);
+		const ub = b.unscaled * 10n ** BigInt(scale - b.scale);
+		return [ua, ub, scale];
+	}
+
+	public add(other: Decimal): Decimal {
+		const [ua, ub, scale] = Decimal.align(this, other);
+		return new Decimal(ua + ub, scale);
